  "viewports": [
    {
      "id": "mobile",
      "width": 390,
      "height": 900
    },
    {
      "id": "desktop",
      "width": 1280,
      "height": 900
    }
  ],
  "defaultMatrixViewports": [
    "mobile",
    "desktop"
  ],
  "evidence": {
    "output": "smoke-results/content-site-modernizer",
    "json": "content-site-smoke-results.json",
    "markdown": "content-site-smoke-summary.md",
    "failureArtifacts": [
      "screenshot",
      "htmlSnapshot",
      "trace",
      "consoleLog"
    ],
    "liveOutput": "smoke-results/content-site-modernizer-live"
  },
  "interactions": {
    "enabledByDefault": true,
    "checks": [
      "drawer",
      "cardActions",
      "searchFilter",
      "loadMore",
      "pagetualAppend"
    ],
    "feedFixturesOnly": true
  },
  "liveSmoke": {
    "enabledByFlagOnly": true,
    "blocksThirdPartyByDefault": true,
    "interactionsRequireFlag": true,
    "pagetualInjectionRequiresFlag": true,
    "driftReport": {
      "report": "content-site-live-drift.md",
      "minCardRatio": 0.5,
      "warnCardRatio": 0.75,
      "missingSelectorSeverity": "medium",
      "failSeverity": "high",
      "nonFailingByDefault": true
    },
    "baseline": {
      "path": "tools/smoke/live-baselines/content-site-modernizer-live-baseline.json",
      "report": "content-site-live-baseline.md",
      "minCardRatio": 0.6,
      "warnCardRatio": 0.8,
      "warnHighCardRatio": 1.5,
      "maxCardRatio": 2.0,
      "missingSelectorSeverity": "high",
      "missingBaselineSeverity": "medium",
      "failSeverity": "high",
      "nonFailingByDefault": true
    }
  },
  "pagetualContract": {
    "version": 2,
    "enabledByFlagOnly": true,
    "checks": [
      "multiAppend",
      "duplicateLinks",
      "activeFilterAppend",
      "restoreAfterFilter"
    ],
    "maxDuplicateCardGrowth": 0
  },
  "accessibilityContract": {
    "enabledByFlagOnly": true,
    "checks": [
      "visibleControlNames",
      "mobileDesktopControlVisibility",
      "drawerDialogSemantics",
      "drawerFocusTrap",
      "drawerEscapeClose",
      "searchInputLabel",
      "bottomNavLabels",
      "cardLinkNames",
      "articleProgressbarSemantics"
    ],
    "focusedSites": [
      "gayteam",
      "putinho",
      "str8upgayporn"
    ]
  },
  "visualRegression": {
    "enabledByFlagOnly": true,
    "baselineDir": "tools/smoke/visual-baselines/content-site-modernizer",
    "outputDir": "smoke-results/content-site-modernizer-visual",
    "report": "content-site-visual-regression.md",
    "defaultFixtures": [
      "home"
    ],
    "focusedSites": [
      "gayteam",
      "putinho",
      "str8upgayporn"
    ],
    "viewports": [
      "mobile",
      "desktop"
    ],
    "thresholdRatio": 0.015,
    "nonFailingByDefault": true,
    "checks": [
      "fixtureScreenshot",
      "acceptedBaselineCompare",
      "thresholdRatio",
      "thumbnailArtifacts",
      "diffArtifacts"
    ]
  }
}
