{
  "name": "@scriptexts/content-site-modernizer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && npm run profiles:check && npm run test",
    "test": "node --check src/core/runtime.template.js && node --test test/*.test.mjs",
    "profiles:check": "node tools/check-profiles.mjs",
    "seal": "node ../../../tools/content-sites/final-seal.mjs --builder content-site-modernizer",
    "release-pack": "node ../../../tools/content-sites/release-pack.mjs --builder content-site-modernizer",
    "release-pack:check": "node ../../../tools/content-sites/release-pack.mjs --builder content-site-modernizer --check"
  },
  "engines": {
    "node": ">=20"
  }
}
