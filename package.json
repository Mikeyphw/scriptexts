{
  "name": "scriptexts",
  "private": true,
  "type": "module",
  "workspaces": [
    "userscripts/builders/content-site-modernizer",
    "userscripts/builders/manga-reader-modernizer",
    "userscripts/builders/myreadingmanga-reimagined",
    "userscripts/builders/sims-cc-download-basket"
  ],
  "scripts": {
    "build": "npm run build:userscripts && npm run build:extensions && npm run userscripts:metadata",
    "build:userscripts": "npm run build:content-sites && npm run build:manga && npm run build:mrm-reimagined && npm run build:sims && npm run build:lpsg",
    "build:content-sites": "npm --prefix userscripts/builders/content-site-modernizer run build",
    "build:manga": "npm --prefix userscripts/builders/manga-reader-modernizer run build",
    "build:sims": "npm --prefix userscripts/builders/sims-cc-download-basket run build",
    "build:extensions": "npm run build:extension:manga && npm run build:extension:stardew && npm run build:extension:telegram",
    "build:extension:manga": "python3 extensions/manga-site-media-downloader/build.py",
    "build:extension:stardew": "python3 extensions/stardew-nexus-download-queue/build.py",
    "build:extension:telegram": "python3 extensions/telegram-media-downloader/build.py",
    "userscripts:metadata": "node tools/generate-userscript-meta.mjs",
    "check": "npm run check:userscripts",
    "inventory": "node tools/inventory.mjs",
    "builder": "bash tools/run-builder.sh",
    "smoke:content-sites": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer",
    "smoke:content-sites:list": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --list",
    "smoke:content-sites:check": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --check-config",
    "smoke:content-sites:matrix": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --all --matrix",
    "smoke:content-sites:report": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --report smoke-results/content-site-modernizer/content-site-smoke-results.json",
    "smoke:content-sites:interactions": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --site gayteam --site putinho --site str8upgayporn --matrix",
    "smoke:content-sites:live": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --matrix",
    "smoke:content-sites:live:focused": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --site gayteam --site putinho --site str8upgayporn --matrix",
    "smoke:content-sites:live:drift": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --all --matrix --live-drift",
    "smoke:content-sites:live:drift:focused": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --site gayteam --site putinho --site str8upgayporn --matrix --live-drift",
    "smoke:content-sites:live:baseline:capture": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --all --matrix --live-drift --live-baseline-capture",
    "smoke:content-sites:live:baseline:compare": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --all --matrix --live-drift --live-baseline-compare",
    "smoke:content-sites:live:baseline:update": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --all --matrix --live-drift --live-baseline-update",
    "smoke:content-sites:live:baseline:focused": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --live --site gayteam --site putinho --site str8upgayporn --matrix --live-drift --live-baseline-compare",
    "smoke:content-sites:pagetual": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --all --matrix --pagetual-contract",
    "smoke:content-sites:pagetual:focused": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --site gayteam --site putinho --site str8upgayporn --matrix --pagetual-contract",
    "content-sites:new": "node tools/content-sites/new-site.mjs",
    "content-sites:new:dry-run": "node tools/content-sites/new-site.mjs --dry-run",
    "content-sites:fixtures:plan": "node tools/content-sites/fixture-refresh.mjs --plan",
    "content-sites:fixtures:apply": "node tools/content-sites/fixture-refresh.mjs --apply",
    "smoke:content-sites:a11y": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --all --matrix --a11y-contract",
    "smoke:content-sites:a11y:focused": "python3 tools/smoke/run-content-site-smoke.py --builder content-site-modernizer --site gayteam --site putinho --site str8upgayporn --matrix --a11y-contract",
    "smoke:content-sites:visual:list": "python3 tools/smoke/run-content-site-visual.py --builder content-site-modernizer --list",
    "smoke:content-sites:visual:check": "python3 tools/smoke/run-content-site-visual.py --builder content-site-modernizer --check-config",
    "smoke:content-sites:visual:capture": "python3 tools/smoke/run-content-site-visual.py --builder content-site-modernizer --all --matrix --capture",
    "smoke:content-sites:visual:compare": "python3 tools/smoke/run-content-site-visual.py --builder content-site-modernizer --all --matrix --compare",
    "smoke:content-sites:visual:focused": "python3 tools/smoke/run-content-site-visual.py --builder content-site-modernizer --site gayteam --site putinho --site str8upgayporn --matrix --compare",
    "content-sites:profiles:check": "npm --prefix userscripts/builders/content-site-modernizer run profiles:check",
    "content-sites:seal": "node tools/content-sites/final-seal.mjs",
    "content-sites:seal:json": "node tools/content-sites/final-seal.mjs --json",
    "content-sites:release-pack": "node tools/content-sites/release-pack.mjs",
    "content-sites:release-pack:check": "node tools/content-sites/release-pack.mjs --check --json",
    "smoke:env:doctor": "bash tools/smoke/with-smoke-env.sh --doctor",
    "smoke:env:sync": "bash tools/smoke/with-smoke-env.sh --sync",
    "smoke:env:install-browsers": "bash tools/smoke/with-smoke-env.sh --install-browsers",
    "smoke:env:shell": "bash tools/smoke/with-smoke-env.sh --shell",
    "smoke:with-env": "bash tools/smoke/with-smoke-env.sh --",
    "smoke:content-sites:interactions:managed": "bash tools/smoke/with-smoke-env.sh -- npm run smoke:content-sites:interactions --",
    "smoke:content-sites:pagetual:managed": "bash tools/smoke/with-smoke-env.sh -- npm run smoke:content-sites:pagetual:focused --",
    "smoke:content-sites:a11y:managed": "bash tools/smoke/with-smoke-env.sh -- npm run smoke:content-sites:a11y:focused --",
    "smoke:content-sites:visual:managed": "bash tools/smoke/with-smoke-env.sh -- npm run smoke:content-sites:visual:focused --",
    "smoke:content-sites:live:managed": "bash tools/smoke/with-smoke-env.sh -- npm run smoke:content-sites:live:focused --",
    "build:mrm-reimagined": "npm --prefix userscripts/builders/myreadingmanga-reimagined run build:verify",
    "build:mrm-reimagined:write": "npm --prefix userscripts/builders/myreadingmanga-reimagined run build",
    "check:mrm-reimagined": "npm --prefix userscripts/builders/myreadingmanga-reimagined run check",
    "smoke:mrm-reimagined": "npm --prefix userscripts/builders/myreadingmanga-reimagined run smoke",
    "build:lpsg": "npm --prefix userscripts/builders/lpsg-media-gallery-unlocker run build",
    "check:lpsg": "npm --prefix userscripts/builders/lpsg-media-gallery-unlocker run build:check",
    "test:lpsg": "npm --prefix userscripts/builders/lpsg-media-gallery-unlocker test",
    "seal:lpsg": "node userscripts/builders/lpsg-media-gallery-unlocker/release-seal.mjs",
    "seal:lpsg:json": "node userscripts/builders/lpsg-media-gallery-unlocker/release-seal.mjs --json",
    "content-sites:bleedingcool:seal": "npm --prefix userscripts/builders/content-site-modernizer run seal:bleedingcool",
    "content-sites:bleedingcool:seal:json": "npm --prefix userscripts/builders/content-site-modernizer run seal:bleedingcool:json",
    "check:repo:static": "node tools/check-repo.mjs",
    "test:userscripts:validation": "node --test tools/tests/userscript-validation.test.mjs",
    "check:userscripts": "node tools/check-userscripts.mjs",
    "test:telegram": "node --test userscripts/standalone/telegram-media-downloader/test/*.test.mjs",
    "test:sims": "npm --prefix userscripts/builders/sims-cc-download-basket test",
    "seal:sims": "npm --prefix userscripts/builders/sims-cc-download-basket run seal",
    "test:utilities": "node --test tools/tests/utility-userscripts.test.mjs",
    "check:poast": "npm --prefix userscripts/builders/poast-timeline-metadata-reset run build:check",
    "seal:poast": "npm --prefix userscripts/builders/poast-timeline-metadata-reset run seal"
  },
  "engines": {
    "node": ">=20"
  }
}
