        "includes": [
          "scripts/*.user.js",
          "meta/*.meta.js",
          "manifest.json",
          "checksums.sha256",
          "RELEASE_INDEX.md"
        ],
        "policy": "dependency-free ZIP packer for generated content-site userscripts; check mode is browser-free and does not write output",
        "normalValidation": "browser-free"
      }
