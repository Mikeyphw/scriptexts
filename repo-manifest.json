        "normalValidation": "browser-free",
        "pagetual_ingest": "marker compatibility, hidden-root inclusion, anti-starvation source selection, direct insert ingest, PAGETUAL_SCRIPT fallback, and opt-in managed browser smoke gate"
      },
      "release_pack": {
        "script": "npm run content-sites:release-pack",
