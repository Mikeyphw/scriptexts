      "runtime_migration": {
        "menofporn-modern-ui": "migrated from retired src/sites/menofporn direct source to src/profiles/menofporn.mjs",
        "putinho-modern-ui": "migrated from retired src/sites/putinho direct source to src/profiles/putinho.mjs",
        "retired_source_stubs": [
