        "accessibility_policy": "flag-only browser smoke; no axe dependency; checks shared chrome semantics and keyboard behavior",
        "visual_script": "npm run smoke:content-sites:visual:compare",
        "visual_capture_script": "npm run smoke:content-sites:visual:capture",
        "focused_visual_script": "npm run smoke:content-sites:visual:focused",
        "visual_baseline_dir": "tools/smoke/visual-baselines/content-site-modernizer",
        "visual_evidence_dir": "smoke-results/content-site-modernizer-visual",
        "visual_report": "content-site-visual-regression.md",
        "visual_policy": "opt-in browser smoke; compare is report-only by default; --fail-on-visual-diff turns baseline drift into a failure",
