  "pagetual_contract_v2_policy": {
    "scope": "content-site-modernizer",
    "commands": [
      "smoke:content-sites:pagetual",
      "smoke:content-sites:pagetual:focused"
    ],
    "checks": [
      "multiAppend",
      "duplicateLinks",
      "activeFilterAppend",
      "restoreAfterFilter"
    ],
    "normalValidation": "browser-free"
  },
  "content_site_onboarding_policy": {
    "scope": "content-site-modernizer",
    "generator": "tools/content-sites/new-site.mjs",
    "fixture_refresh": "tools/content-sites/fixture-refresh.mjs",
    "safety": [
      "new-site refuses overwrites unless --force is passed",
      "fixture-refresh backs up targets before replacement",
      "fixture-refresh refuses retained smoke snapshots unless --allow-smoke-snapshot is passed"
    ],
    "normalValidation": "browser-free"
  },
  "content_site_accessibility_contract_policy": {
    "scope": "content-site-modernizer",
    "commands": [
      "smoke:content-sites:a11y",
      "smoke:content-sites:a11y:focused"
    ],
    "checks": [
      "visibleControlNames",
      "mobileDesktopControlVisibility",
      "drawerDialogSemantics",
      "drawerFocusTrap",
      "drawerEscapeClose",
      "searchInputLabel",
      "bottomNavLabels",
      "cardLinkNames",
      "articleProgressbarSemantics"
    ],
    "normalValidation": "browser-free",
    "dependencyPolicy": "no additional npm dependency; Playwright remains optional through requirements-smoke.txt"
  },
  "content_site_visual_regression_policy": {
    "scope": "content-site-modernizer",
    "commands": [
      "smoke:content-sites:visual:capture",
      "smoke:content-sites:visual:compare",
      "smoke:content-sites:visual:focused"
    ],
    "baselineDir": "tools/smoke/visual-baselines/content-site-modernizer",
    "evidenceDir": "smoke-results/content-site-modernizer-visual",
    "report": "content-site-visual-regression.md",
    "thresholdRatio": 0.015,
    "normalValidation": "browser-free",
    "dependencyPolicy": "Playwright plus optional Pillow through requirements-smoke.txt; no npm dependency"
  },
  "content_site_profile_schema_policy": {
    "scope": "content-site-modernizer",
    "commands": [
      "content-sites:profiles:check"
    ],
    "module": "userscripts/builders/content-site-modernizer/src/core/profile-schema.mjs",
    "normalizedAt": "build-time",
    "checks": [
      "unique profile ids",
      "unique outputs",
      "semver versions",
      "https match rules",
      "allowed grants",
      "nav actions",
      "selector shape",
      "capability prerequisites"
    ],
    "normalValidation": "browser-free",
    "dependencyPolicy": "no npm dependency; pure Node schema module"
  },
  "content_site_final_seal_policy": {
    "tool": "tools/content-sites/final-seal.mjs",
    "script": "npm run content-sites:seal",
    "json_script": "npm run content-sites:seal:json",
    "scope": "content-site-modernizer shared-runtime builder",
    "browserExecution": "never during normal validation",
    "checks": [
      "profileSchema",
      "sharedRuntimeOnly",
      "generatedOutputFreshness",
      "metaHeaderOnly",
      "smokeConfigCoverage",
      "manifestCoverage",
      "docsMarkers",
      "packageScripts"
    ]
  },
  "content_site_release_pack_policy": {
    "scope": "content-site-modernizer",
    "script": "npm run content-sites:release-pack",
    "check_script": "npm run content-sites:release-pack:check",
    "output": "release/content-site-modernizer/content-site-modernizer-userscripts.zip",
    "checksum": "checksums.sha256",
    "index": "RELEASE_INDEX.md"
  },
  "content_site_smoke_python_env_policy": {
    "scope": "content-site-modernizer",
    "manager": "uv",
    "fallback": "venv+pip",
    "environment": ".venv-smoke",
    "wrapper": "tools/smoke/with-smoke-env.sh",
    "activation": "tools/smoke/activate-smoke-env.sh",
    "devtool_target": "smoke-python",
    "normal_validation": "browser-free",
    "subprocess_activation": "auto-activate and auto-deactivate",
    "browser_cache": "PLAYWRIGHT_BROWSERS_PATH defaults to ~/.cache/ms-playwright"
  },
  "content_site_pagetual_final_seal_policy": {
    "candidate_marker": "data-csm-page-tual-candidate",
    "legacy_candidate_marker": "data-csm-pagetual-candidate",
    "hidden_root_policy": "scan hidden source roots when they contain marked PageTual candidates",
    "source_selection_policy": "skip already-enhanced data-csm-card nodes before selecting raw PageTual candidates",
    "direct_ingest_policy": "pagetual:insert and PageTual postMessage events immediately ingest marked raw nodes into the existing modern feed grid",
    "smoke_summary_marker": "PageTual ingest: simulated insert -> raw candidates selected -> modern cards appended",
    "validator_gate": "PLAYWRIGHT_SMOKE=1 with PAGETUAL_SCRIPT runs managed interaction smoke during Devtool validation"
  }
}
