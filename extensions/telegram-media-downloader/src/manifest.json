{
  "manifest_version": 2,
  "name": "Telegram Media Downloader",
  "version": "3.4.10",
  "description": "Telegram Web media tools with popup, floating media browser, debug mode, and debug panel.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "https://web.telegram.org/*",
    "https://webk.telegram.org/*",
    "https://webz.telegram.org/*"
  ],
  "background": {
    "scripts": [
      "scripts/protocol-v2.js",
      "scripts/common.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Telegram Media Downloader"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": [
        "scripts/common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "page-bridge.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "telegram-media-downloader@mikeyphw.scriptexts",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
